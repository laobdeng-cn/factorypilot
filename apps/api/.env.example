FACTORYPILOT_ENVIRONMENT=development
FACTORYPILOT_DEBUG=false
FACTORYPILOT_LOG_LEVEL=INFO
FACTORYPILOT_LOG_JSON=false
FACTORYPILOT_DATABASE_URL=postgresql+asyncpg://factorypilot:factorypilot@127.0.0.1:55432/factorypilot
FACTORYPILOT_REDIS_URL=redis://127.0.0.1:56379/0
FACTORYPILOT_CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]
FACTORYPILOT_HEALTHCHECK_DATABASE=true
FACTORYPILOT_HEALTHCHECK_REDIS=true
FACTORYPILOT_DATABASE_POOL_SIZE=5
FACTORYPILOT_DATABASE_MAX_OVERFLOW=10
FACTORYPILOT_JWT_SECRET_KEY=factorypilot-development-secret-change-me
FACTORYPILOT_JWT_ALGORITHM=HS256
FACTORYPILOT_JWT_ISSUER=factorypilot
FACTORYPILOT_JWT_AUDIENCE=factorypilot-api
FACTORYPILOT_ACCESS_TOKEN_MINUTES=15
FACTORYPILOT_REFRESH_TOKEN_DAYS=7
